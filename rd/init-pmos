#!/bin/busybox sh
# One-shot USB console init for the existing postmarketOS SM6225/tapas kernel.
# All USB/Type-C/PHY drivers are built into this kernel; do not load modules
# built for the older vendor kernel used by the normal MEOW boot image.
BIN=/bin/busybox
$BIN --install -s /bin

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mkdir -p /dev/pts /dev/config
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t configfs configfs /dev/config 2>/dev/null

[ -e /dev/console ] || mknod -m 600 /dev/console c 5 1
[ -e /dev/null ] || mknod -m 666 /dev/null c 1 3
[ -e /dev/tty ] || mknod -m 666 /dev/tty c 5 0
[ -e /dev/fb0 ] || mknod -m 666 /dev/fb0 c 29 0

echo "meow-pmos: kernel $($BIN cat /proc/version)"
echo "meow-pmos: waiting for built-in USB controller"
$BIN sleep 3
for d in /sys/bus/platform/devices/*usb*; do
	[ -e "$d" ] || continue
	DR=$($BIN readlink "$d/driver" 2>/dev/null)
	echo "meow-pmos: platform $(/bin/busybox basename "$d") driver=$DR"
done

UDC=$($BIN ls /sys/class/udc 2>/dev/null | $BIN head -1)
if [ -n "$UDC" ] && [ -d /dev/config/usb_gadget ]; then
	G=/dev/config/usb_gadget/meow
	$BIN mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409" "$G/functions/acm.usb0"
	echo 0x18d1 > "$G/idVendor"
	echo 0x4e42 > "$G/idProduct"
	echo meow > "$G/strings/0x409/manufacturer"
	echo meow-topaz > "$G/strings/0x409/product"
	echo meow-debug > "$G/strings/0x409/serialnumber"
	echo serial > "$G/configs/c.1/strings/0x409/configuration"
	$BIN ln -s "$G/functions/acm.usb0" "$G/configs/c.1/acm.usb0" 2>/dev/null
	echo "$UDC" > "$G/UDC" 2>/dev/null
	echo "meow-pmos: bound UDC $($BIN cat "$G/UDC" 2>/dev/null)"
else
	echo "meow-pmos: no UDC found"
fi

GS=$($BIN grep ttyGS /proc/devices 2>/dev/null | $BIN awk '{print $1}' | $BIN head -1)
if [ -n "$GS" ]; then
	[ -e /dev/ttyGS0 ] || mknod -m 600 /dev/ttyGS0 c "$GS" 0
	echo "meow-pmos: ttyGS0 major $GS; root shell on USB ACM"
	$BIN getty -n -l /bin/sh -L 115200 ttyGS0 vt100 &
fi

for f in /sys/class/udc/*/state; do
	[ -r "$f" ] && echo "meow-pmos: UDC state $($BIN cat "$f")"
done
echo "meow-pmos: USB kernel messages"
$BIN dmesg 2>/dev/null | $BIN grep -i -E 'dwc3|usb|typec|phy|role' | $BIN tail -15
echo "meow-pmos: init complete"
while :; do $BIN sleep 3600; done
